# 复制为 .env 后修改。server.js 启动时会自动读取本文件（零依赖实现）。
# 注意：.env 已在 .gitignore 中，不会被提交。

# 监听端口
PORT=8787

# 监听地址（0.0.0.0 允许外部访问，127.0.0.1 只允许本机）
HOST=127.0.0.1

# 管理后台密码。留空则回退到 config/site.json 的 admin.password（默认 admin，极不安全）
ADMIN_PASSWORD=

# 用于给支付回调签名 / 订单查询 token 加盐。生产环境务必改成随机值：
#   openssl rand -hex 32
APP_SECRET=
